# Dockerfile for running RISC Zero hello-world in Intel TDX
# This creates a container image that can be deployed to TDX-enabled infrastructure

FROM ubuntu:22.04

# Metadata
LABEL maintainer="RISC Zero <hello@risczero.com>"
LABEL description="RISC Zero hello-world with Intel TDX attestation support"
LABEL version="1.0"

# Avoid prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV RUST_VERSION=1.75.0

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    wget \
    git \
    pkg-config \
    libssl-dev \
    python3 \
    python3-pip \
    kmod \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain ${RUST_VERSION}

ENV PATH="/root/.cargo/bin:${PATH}"

# Verify Rust installation
RUN rustc --version && cargo --version

# Set working directory
WORKDIR /app

# Copy the hello-world example
COPY . /app/

# Make scripts executable
RUN chmod +x /app/run-in-tdx.sh /app/verify-attestation.sh

# Pre-build the example (optional, to speed up first run)
# RUN cargo build --release --features prove

# Create output directory
RUN mkdir -p /app/tdx-output

# Default command
CMD ["/app/run-in-tdx.sh"]

# Health check (optional)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD [ -f /app/tdx-output/attestation-bundle.json ] || exit 1

# Volumes for output
VOLUME ["/app/tdx-output"]

# Environment variables
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1

